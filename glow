  <form class="card" id="f" novalidate><h2>Who is playing? 🌟</h2>
    <div class="fields"><label for="nm">Your name<input id="nm" maxlength="20" autocomplete="off" placeholder="e.g. Maya"></label>
    <label for="ag">Your age<input id="ag" type="number" inputmode="numeric" min="8" max="18" placeholder="8 to 18"></label></div>
    <div class="err" id="err" role="alert">${msg||''}</div>
    <div class="row" style="justify-content:flex-start"><button class="go" type="submit">Let's glow! ✨</button></div>
    ${list.length?`<div><p style="color:var(--muted);font-weight:800;margin-bottom:8px">Or jump back in:</p><div class="saved">${list.map(([id,p])=>`<button type="button" class="ghost" data-id="${esc(id)}">${esc(p.name)}, ${p.age} →</button>`).join('')}</div></div>`:''}
  </form>`;
  document.getElementById('f').onsubmit=e=>{e.preventDefault();
    const name=document.getElementById('nm').value.trim(),age=parseInt(document.getElementById('ag').value,10);
    if(!name){document.getElementById('err').textContent='Please type your name 💜';return}
    if(!(age>=8&&age<=18)){document.getElementById('err').textContent='Please enter an age from 8 to 18 🌈';return}
    const id=name.toLowerCase();
    const old=db.players[id];
    db.players[id]={name,age,progress:old?old.progress:{}};db.current=id;save();home();
  };
  app.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>{db.current=b.dataset.id;save();home()});
}

function home(){
  clearInterval(timer);
  const p=me();if(!p)return welcome();
  const prog=p.progress, band=bandOf(p.age), earned=Object.keys(prog).length;
  const hi=earned===LEVELS.length?`You collected every badge! You are a Glow Champion! 🏆`:earned?`You have ${earned} of ${LEVELS.length} badges. Keep shining! ✨`:`Ready for your first level? You've got this! 💪`;
  app.innerHTML=`<div class="top"><div class="wm">GLOW<small>GAME</small></div><button class="ghost" id="sw">Switch player</button></div>
  <div class="glowie"><div class="orb">🌟</div><div><small>AI Glowie</small><p>Hi ${esc(p.name)}! ${hi}</p><div class="meta" style="margin-top:8px"><span class="chip g">${BANDS[band]} questions</span></div></div></div>
  ${scoreCard(p)}
  ${LEVELS.map((l,i)=>{const m=MODULES[i],b=prog[l.level];
   return `<section class="lvl">
   <div><div class="tag">${esc(m.name)} · ${esc(m.tagline)}</div><h3>${ICONS[i]} Level ${l.level}: ${esc(l.name)}</h3></div>
   <div class="act"><button class="go" data-l="${l.level}">${b?'Replay':'Hints & play'}</button></div>
   <p class="desc">${esc(m.desc)}</p>
   <div class="badges" aria-label="Badges for this level">${['gold','silver','bronze'].map(k=>`<span class="bd ${b===k?'on':''}" title="${b===k?'Earned!':'Not earned yet'}">${MEDAL[k]} ${esc(l[k+'Badge'])}${b===k?' ✓':''}</span>`).join('')}</div>
   <div class="meta"><span class="chip">${esc(l.focus)}</span><span class="chip">${esc(l.difficulty)}</span><span class="chip">⏱ ${secsFor(l,band)/60} mins</span><span class="chip">5 questions</span></div></section>`}).join('')}`;
  document.getElementById('sw').onclick=()=>welcome();
  app.querySelectorAll('[data-l]').forEach(b=>b.onclick=()=>lesson(+b.dataset.l));
}
const secsFor=(l,band)=>(parseInt(l.time)+(band==='young'?1:0))*60;
const cut=total=>({gold:Math.floor(total*.5),silver:Math.floor(total*.75),bronze:total});
const tiersHTML=(l,total)=>{const c=cut(total);return ['gold','silver','bronze'].map(k=>`<div class="tier"><span aria-hidden="true">${MEDAL[k]}</span><span>${esc(l[k+'Badge'])}</span><em>${k==='bronze'?'by':'under'} ${fmt(c[k])}</em></div>`).join('')};
const BONUS={gold:30,silver:20,bronze:10}, MAXPTS=LEVELS.length*(5*10+30);
const totalPts=p=>Object.values(p.scores||{}).reduce((a,b)=>a+b,0);
const doneAll=p=>LEVELS.every(l=>p.progress[l.level]);
const titleFor=pts=>pts>=MAXPTS*.85?'Glow Legend 💎':pts>=MAXPTS*.6?'Glow Star 🌟':pts>=MAXPTS*.3?'Rising Glow ✨':'Glow Starter 🌱';
const thanks=p=>`Thank you for learning to stay safe online, ${esc(p.name)}! You are brave, smart and kind, and the internet is a better place with you in it. Keep glowing! 💖`;
function scoreCard(p){const pts=totalPts(p),n=LEVELS.filter(l=>p.progress[l.level]).length,all=doneAll(p);
return `<div class="card score"><div class="srow"><div><div class="lab">Total score</div><div class="num">⭐ ${pts}<span> / ${MAXPTS}</span></div><div class="rank">${titleFor(pts)}</div></div>
<div class="champ ${all?'on':''}"><div class="crown" aria-hidden="true">👑</div><div><strong>Glow Champion</strong><span>${all?'Unlocked! You are amazing! 🎉':'Earn a badge on all '+LEVELS.length+' levels ('+n+' of '+LEVELS.length+' so far)'}</span></div></div></div>
<div class="track" aria-hidden="true"><div class="fill" style="width:${Math.min(100,pts/MAXPTS*100)}%"></div></div>${all?'<p class="thanks">'+thanks(p)+'</p>':''}</div>`}
const PRAISE=['You locked your digital front door like a pro! 🔐','You can spot tricks and scams now. Nothing gets past you! 🕵️','You showed kindness and courage. You make the internet a safer place! 💜','You think like a true leader and fact detective! 🌟'];
const fmt=s=>Math.floor(s/60)+':'+String(s%60).padStart(2,'0');

function lesson(n){
  const p=me(),band=bandOf(p.age),l=LEVELS.find(x=>x.level===n),L=LESSONS[band][n-1];
  app.innerHTML=`<div class="top"><button class="ghost" id="bk">← Levels</button><span class="chip g">${ICONS[n-1]} Level ${n} · ${esc(l.name)}</span></div>
  <article class="card lesson"><span class="chip" style="align-self:flex-start">💡 Hints before you play</span>
  <h2>${ICONS[n-1]} ${esc(L.title)}</h2>
  <ul>${L.points.map(([e,t])=>`<li><span class="e" aria-hidden="true">${e}</span><span>${esc(t)}</span></li>`).join('')}</ul>
  <div class="remember">${esc(L.remember)}</div></article>
  <div class="card"><h2>🏅 Badges you can earn</h2><div class="tiers">${tiersHTML(l,secsFor(l,band))}</div><p style="color:var(--muted)">Finish all 5 questions before the clock runs out and you always earn a badge. The faster you finish, the better it is! ⚡ Each right answer is 10 points, and badges add bonus points: 🥇 +30, 🥈 +20, 🥉 +10.</p></div>
  <div class="glowie"><div class="orb">🌟</div><div><small>AI Glowie says</small><p>${esc(l.tip)} Your clock starts when you press the button, so read the hints first. ⏱ ${fmt(secsFor(l,band))}</p></div></div>
  <div class="row"><button class="go" id="rd">I'm ready! Start the quiz 🚀</button></div>`;
  document.getElementById('bk').onclick=home;
  document.getElementById('rd').onclick=()=>start(n);
}

function start(n){
  const p=me(),band=bandOf(p.age),lv=LEVELS.find(l=>l.level===n),secs=secsFor(lv,band);
  const qs=QUIZ[band].filter(q=>q.level===n).map(q=>({text:q.text,fb:q.fb,opts:shuffle(q.options.map((t,i)=>({t,ok:i===q.a})))}));
  st={lv,qs,i:0,score:0,left:secs,total:secs,done:false,picked:false};
  clearInterval(timer);
  timer=setInterval(()=>{st.left--;if(st.left<=0){st.left=0;clearInterval(timer);finish(true)}else tick()},1000);
  question();
}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function tick(){const t=document.getElementById('time');if(!t)return;t.textContent=fmt(st.left);t.classList.toggle('low',st.left<=30);document.getElementById('tl').setAttribute('aria-valuenow',st.left)}
function question(){
  const q=st.qs[st.i];st.picked=false;
  app.innerHTML=`<div class="top"><button class="ghost" id="quit">← Levels</button><span class="chip g">${ICONS[st.lv.level-1]} Level ${st.lv.level} · ${esc(st.lv.name)}</span></div>
  <div class="bar"><div class="track" id="tl" role="progressbar" aria-valuemin="0" aria-valuemax="${st.total}" aria-valuenow="${st.left}" aria-label="Time left"><div class="fill" style="width:${st.i/st.qs.length*100}%"></div></div><div class="time" id="time">${fmt(st.left)}</div></div>
  <div class="card"><span class="chip" style="align-self:flex-start">Question ${st.i+1} of ${st.qs.length}</span><h2>${esc(q.text)}</h2>
  <div class="ans">${q.opts.map((o,k)=>`<button class="opt" data-k="${k}"><b>${'ABC'[k]}</b><span>${esc(o.t)}</span></button>`).join('')}</div>
  <div id="fb"></div></div>`;
  document.getElementById('quit').onclick=home;
  app.querySelectorAll('.opt').forEach(b=>b.onclick=()=>answer(+b.dataset.k));
  tick();
}
function answer(k){
  if(st.picked)return;st.picked=true;
  const q=st.qs[st.i],ok=q.opts[k].ok;if(ok)st.score++;
  app.querySelectorAll('.opt').forEach((b,i)=>{b.disabled=true;if(q.opts[i].ok)b.classList.add('right');else if(i===k)b.classList.add('wrong')});
  const last=st.i===st.qs.length-1;
  document.getElementById('fb').innerHTML=`<div class="fb ${ok?'ok':'no'}"><strong>${ok?pick(YES):pick(NO)}</strong>${ok?'':`The best answer is “${esc(q.opts.find(o=>o.ok).t)}”. `}${esc(q.fb)}</div><div class="row" style="margin-top:14px"><button class="go" id="next">${last?'See my badge 🏅':'Next question ➜'}</button></div>`;
  const n=document.getElementById('next');n.focus();
  n.onclick=()=>{st.i++;last?finish(false):question()};
}
function finish(timeout){
  clearInterval(timer);st.done=true;
  const p=me(),s=st.score,n=st.qs.length,lv=st.lv.level;
  const used=st.total-st.left,c=cut(st.total);
  const badge=timeout?null:used<=c.gold?'gold':used<=c.silver?'silver':'bronze';
  const wasAll=doneAll(p);
  const pts=s*10+(badge?BONUS[badge]:0);
  p.scores=p.scores||{};
  if(pts>(p.scores[lv]||0))p.scores[lv]=pts;
  if(badge&&(!p.progress[lv]||rank[badge]>rank[p.progress[lv]]))p.progress[lv]=badge;
  const newChamp=!wasAll&&doneAll(p);
  save();
  const name=badge?st.lv[badge+'Badge']:null;
  const talk=badge==='gold'?'Lightning fast and super smart! You are glowing so bright! 🌟🎉':badge==='silver'?'Great speed! A little faster for Gold? ⚡':badge==='bronze'?'You completed the level! Replay to be quicker and climb higher. 🚀':timeout?'Time ran out before you finished. Finish all 5 questions in time to earn your badge. You can do it! 🌈':'Keep going! 💪';
  app.innerHTML=`<div class="top"><div class="wm">GLOW<small>GAME</small></div></div>
  <div class="card big">${timeout?`<h2>Time's up! ⏰</h2>`:`<div class="praise"><div class="cf" aria-hidden="true">🎉✨🌟💖🎊</div><h2>Well done, ${esc(p.name)}!</h2><p>${PRAISE[lv-1]}</p><p style="color:var(--pink)">${s<3?'You finished the level! Check the hints again to get more answers right. 💪':badge==='gold'?'A Gold finish. Incredible speed! 🥇':badge==='silver'?'A Silver finish. So quick! 🥈':'You completed Level '+lv+'. Every level makes you stronger! 🥉'}</p></div>`}
  <p style="color:var(--lav);font-weight:800">${esc(p.name)}, you got ${s} of ${n} right ${timeout?'before time ran out':'in '+fmt(used)}. ⏱</p>
  <div class="medal ${badge?'on':''}">${badge?MEDAL[badge]:'💫'}</div>
  <h2>${badge?'You earned the '+esc(name)+'!':'No badge this time'}</h2><div class="tiers" style="width:100%;text-align:left">${tiersHTML(st.lv,st.total)}</div>
  <p style="font-weight:800;color:var(--pink)">⭐ +${pts} points (${s} × 10${badge?' + '+BONUS[badge]+' badge bonus':''}). Total score: ${totalPts(p)} / ${MAXPTS}</p>
  ${newChamp?`<div class="champwin"><div class="crown" aria-hidden="true">👑</div><h2>Glow Champion unlocked!</h2><p>${thanks(p)}</p><p style="color:var(--pink);font-weight:800">You earned a badge on every level. Final rank: ${titleFor(totalPts(p))}</p></div>`:''}
  <div class="glowie" style="text-align:left;width:100%"><div class="orb">🌟</div><div><small>AI Glowie says</small><p>${talk}</p></div></div>
  <div class="row">${lv<LEVELS.length&&!timeout?'<button class="go" id="nx">Next level ➜</button>':''}<button class="${lv<LEVELS.length&&!timeout?'ghost':'go'}" id="again">Play again 🔁</button><button class="ghost" id="les">Read the hints</button><button class="ghost" id="home">All levels</button></div></div>`;
  const nx=document.getElementById('nx');if(nx)nx.onclick=()=>lesson(lv+1);
  document.getElementById('again').onclick=()=>start(lv);
  document.getElementById('les').onclick=()=>lesson(lv);
  document.getElementById('home').onclick=home;
}
if(db.current&&db.players[db.current])home();else welcome();
</script>

</body>
</html>
