<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0720">
<title>Glow Quest</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;800&display=swap">
<style>
/* Layout: single centered column on a night-sky ground. Welcome (artwork + player form) > Home (level cards) > Lesson > Quiz > Result. One look, taken from the Glow artwork: midnight indigo, violet glow, pink accents. */
:root{
  --bg:#0b0720; --bg2:#150d36; --surface:#1a1145; --line:#43348c;
  --violet:#a78bfa; --violet-deep:#6d3fd9; --lav:#d9ccff; --pink:#ff7ac6; --pink-deep:#e8359b;
  --ink:#f4efff; --muted:#aa9ed6; --on-pink:#34082a;
  --good:#6ee7b0; --good-soft:#0f3a2e; --bad:#ff9db1; --bad-soft:#4a1630;
  --glow-a:#3b2390; --glow-b:#25134f; --glow-soft:rgba(139,92,246,.22); --pink-glow:rgba(255,95,176,.38);
  --display:'Fredoka','Trebuchet MS',sans-serif; --body:'Nunito','Segoe UI',sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:radial-gradient(800px 460px at 85% -8%,var(--glow-a),transparent 62%),radial-gradient(640px 400px at 0% 18%,var(--glow-b),transparent 60%),var(--bg);
  color:var(--ink);font:400 16px/1.55 var(--body);padding-block:18px 56px;min-height:100%;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
main{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance;line-height:1.18}
p{margin:0}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--pink);outline-offset:2px}
.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.wm{font:700 32px/1 var(--display);letter-spacing:.02em;color:var(--pink);background:linear-gradient(90deg,var(--pink),var(--lav));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;display:flex;align-items:baseline;gap:8px}
.wm small{font:600 12px var(--display);letter-spacing:.35em;color:var(--lav);-webkit-text-fill-color:var(--lav)}
.ghost{background:transparent;border:2px solid var(--line);color:var(--lav);border-radius:999px;padding:6px 14px;font-weight:800;font-size:14px}
.ghost:hover{border-color:var(--violet)}
.go{background:linear-gradient(180deg,var(--pink),var(--pink-deep));color:var(--on-pink);border:0;border-radius:999px;padding:11px 22px;font:600 17px var(--display);box-shadow:0 0 22px var(--pink-glow)}
.go:hover{filter:brightness(1.07)}
.card{background:var(--surface);border:1.5px solid var(--line);border-radius:22px;padding:20px;display:flex;flex-direction:column;gap:16px;box-shadow:0 0 34px var(--glow-soft)}
.card h2{font-size:23px}
.hero{width:100%;border-radius:24px;border:1.5px solid var(--line);box-shadow:0 0 40px var(--glow-soft);display:block}
label{display:flex;flex-direction:column;gap:6px;font-weight:800;color:var(--lav)}
input{background:var(--bg2);border:2px solid var(--line);border-radius:14px;padding:12px 14px;font-size:17px;width:100%}
input:focus{border-color:var(--pink);outline:none}
.fields{display:grid;grid-template-columns:1fr 130px;gap:12px}
.err{color:var(--bad);font-weight:800;min-height:1.4em}
.saved{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-size:12px;font-weight:800;border-radius:999px;padding:3px 11px;background:var(--bg2);color:var(--lav);border:1px solid var(--line)}
.chip.g{color:var(--pink);border-color:var(--pink-deep)}
.glowie{display:flex;gap:12px;align-items:flex-start;background:var(--bg2);border:1.5px solid var(--violet-deep);border-radius:20px;padding:14px 16px}
.orb{flex:none;width:44px;height:44px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffe6f4,var(--pink) 55%,var(--pink-deep));box-shadow:0 0 20px var(--pink-glow);display:grid;place-items:center;font-size:22px}
.glowie small{display:block;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--pink);font-size:11px}
.glowie p{font-weight:600}
.lvl{background:var(--surface);border:1.5px solid var(--line);border-radius:22px;padding:18px;display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center;box-shadow:0 0 30px var(--glow-soft)}
.ico{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;font-size:28px;background:var(--bg2);border:2px solid var(--violet-deep);box-shadow:0 0 18px var(--glow-soft)}
.badges{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px}
.bd{font-size:13px;font-weight:800;border-radius:999px;padding:5px 12px;background:var(--bg2);border:1.5px dashed var(--line);color:var(--muted)}
.bd.on{border:1.5px solid var(--pink);color:var(--ink);box-shadow:0 0 16px var(--pink-glow)}
.score .srow{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between}
.lab{font-weight:800;letter-spacing:.1em;text-transform:uppercase;font-size:11px;color:var(--muted)}
.num{font:700 36px/1.1 var(--display);color:var(--pink);font-variant-numeric:tabular-nums}
.num span{font-size:18px;color:var(--muted)}
.rank{font:600 18px var(--display)}
.champ{display:flex;gap:12px;align-items:center;border:1.5px dashed var(--line);border-radius:18px;padding:10px 14px;color:var(--muted);min-width:0}
.champ strong{display:block;font:600 18px var(--display)}
.champ span{font-size:14px}
.crown{font-size:36px;filter:grayscale(1);opacity:.5}
.champ.on{border:1.5px solid var(--pink);color:var(--ink);box-shadow:0 0 24px var(--pink-glow)}
.champ.on .crown,.champwin .crown{filter:none;opacity:1}
.thanks{color:var(--lav);font-weight:700}
.praise{width:100%;border-radius:20px;padding:16px;background:linear-gradient(135deg,var(--bg2),var(--glow-a));border:1.5px solid var(--pink);box-shadow:0 0 26px var(--pink-glow);display:flex;flex-direction:column;gap:6px;align-items:center}
.praise .cf{font-size:30px;letter-spacing:.2em}
.praise p{font-weight:700}
.champwin{width:100%;border:2px solid var(--pink);border-radius:20px;padding:18px;background:var(--bg2);box-shadow:0 0 34px var(--pink-glow);display:flex;flex-direction:column;align-items:center;gap:8px}
.champwin .crown{font-size:64px}
.tiers{display:flex;flex-direction:column;gap:8px}
.tier{display:flex;gap:10px;align-items:center;background:var(--bg2);border:1.5px solid var(--line);border-radius:14px;padding:10px 12px;font-weight:700}
.tier span:first-child{font-size:26px}
.tier em{font-style:normal;color:var(--pink);font-weight:800;margin-left:auto;white-space:nowrap}
.lvl .tag{font:800 11px var(--body);letter-spacing:.1em;text-transform:uppercase;color:var(--pink)}
.lvl h3{font-size:20px}
.lvl .desc{grid-column:1/-1;color:var(--muted);font-size:14.5px}
.meta{display:flex;flex-wrap:wrap;gap:6px;grid-column:1/-1}
.act{display:flex;gap:10px;align-items:center}
.medal{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-size:26px;background:var(--bg2);border:2px dashed var(--line);color:var(--muted)}
.medal.on{border:2px solid var(--pink);box-shadow:0 0 18px var(--pink-glow)}
.lesson li{list-style:none;display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:start}
.lesson ul{margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.lesson .e{font-size:24px;line-height:1.3}
.remember{background:var(--bg2);border:1.5px solid var(--pink-deep);border-radius:16px;padding:12px 16px;font:600 18px var(--display);color:var(--pink);text-align:center}
.bar{display:flex;align-items:center;gap:12px}
.track{flex:1;height:14px;border-radius:99px;background:var(--bg2);border:1px solid var(--line);overflow:hidden}
.fill{height:100%;background:linear-gradient(90deg,var(--violet-deep),var(--pink));transition:width .3s}
.time{font:600 22px var(--display);font-variant-numeric:tabular-nums;min-width:64px;text-align:right;color:var(--lav)}
.time.low{color:var(--bad)}
.ans{display:flex;flex-direction:column;gap:10px}
.opt{display:flex;gap:12px;text-align:left;align-items:center;background:var(--bg2);border:2px solid var(--line);border-radius:16px;padding:12px 14px;font-weight:600;width:100%}
.opt b{flex:none;width:30px;height:30px;border-radius:50%;background:var(--surface);color:var(--pink);border:1.5px solid var(--violet-deep);display:grid;place-items:center;font-family:var(--display)}
.opt:hover:not(:disabled){border-color:var(--violet)}
.opt.right{background:var(--good-soft);border-color:var(--good)}
.opt.wrong{background:var(--bad-soft);border-color:var(--bad)}
.opt:disabled{cursor:default;color:var(--ink)}
.fb{border-radius:16px;padding:12px 14px;font-weight:600}
.fb.ok{background:var(--good-soft)}.fb.no{background:var(--bad-soft)}
.fb strong{display:block;font:600 19px var(--display)}
.big{align-items:center;text-align:center}
.big .medal{width:120px;height:120px;font-size:64px;border-style:solid}
.row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.pad{margin-top:4px}
@media(max-width:480px){.lvl{grid-template-columns:1fr}.fields{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.fill{transition:none}}
</style>
<style>html{color-scheme:dark;background:#0b0720}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
</head>
<body>
<main id="app"></main>
<script>
const HERO="glow-hero.jpg";
const LEVELS=[{"level": 1, "name": "Glow Beginner", "difficulty": "Easy", "time": "3 mins", "focus": "Passwords & Account Setup", "goldBadge": "Gold Shield", "silverBadge": "Silver Shield", "bronzeBadge": "Bronze Shield", "tip": "Welcome! You have 3 minutes to lock your digital front door with strong passwords."}, {"level": 2, "name": "Glow Explorer", "difficulty": "Mild", "time": "4 mins", "focus": "Phishing & Safe Surfing", "goldBadge": "Gold Inspector", "silverBadge": "Silver Inspector", "bronzeBadge": "Bronze Inspector", "tip": "Spot the tricks! 4 minutes on the clock—check links carefully before you click."}, {"level": 3, "name": "Glow Shield", "difficulty": "Moderate", "time": "5 mins", "focus": "Cyberbullying & Well-being", "goldBadge": "Gold Guardian", "silverBadge": "Silver Guardian", "bronzeBadge": "Bronze Guardian", "tip": "You control your space! You have 5 minutes to solve these real-world scenarios."}, {"level": 4, "name": "Glow Leader", "difficulty": "Advanced", "time": "5 mins", "focus": "Fake News & Leadership", "goldBadge": "Gold Leader", "silverBadge": "Silver Leader", "bronzeBadge": "Bronze Leader", "tip": "Final challenge! Show your leadership skills and spot misinformation before time runs out."}], MODULES=[{"name": "LEARN", "tagline": "Digital Basics & Safety", "desc": "Foundational skills for navigating the digital world safely."}, {"name": "EXPLORE", "tagline": "Knowledge & Opportunity", "desc": "Safe ways to discover positive content, interests, and opportunities online."}, {"name": "STAY SAFE", "tagline": "Privacy & Security", "desc": "Essential tools and practices to protect your data, accounts, and privacy."}, {"name": "BE STRONG", "tagline": "Confidence & Well-being", "desc": "Building mental resilience, positive self-talk, and digital wellness."}], QUIZ={"young": [{"level": 1, "text": "Which password is the strongest?", "options": ["Purple-Rocket-Tiger-42!", "sunny123", "mypassword"], "a": 0, "fb": "Long, mixed-up words with a number and a symbol make a super strong lock. 🔐"}, {"level": 1, "text": "Who is it OK to tell your password to?", "options": ["A parent or trusted grown-up", "Your whole class", "Anyone who asks nicely"], "a": 0, "fb": "Passwords are secrets. Only a trusted grown-up should ever help with them. 🤫"}, {"level": 1, "text": "What is a safe picture for your game profile?", "options": ["A cartoon or animal picture", "A photo of your school", "A photo of your front door"], "a": 0, "fb": "Great choice! A cartoon keeps your real life private. 🦄"}, {"level": 1, "text": "A game asks for your home address to sign up. What do you do?", "options": ["Stop and ask a grown-up", "Type it in quickly", "Ask a friend to type it"], "a": 0, "fb": "Smart! Never share your address online without a grown-up. 🏠"}, {"level": 1, "text": "What is 2FA (two-step login)?", "options": ["A second step, like a code, to prove it is really you", "Two passwords you share with a friend", "A game for two players"], "a": 0, "fb": "It's like a second lock on your door. Double the safety! 🔒"}, {"level": 2, "text": "A pop-up says \"You won a free game! Click here!\" What do you do?", "options": ["Close it and tell a grown-up", "Click it right away", "Type your name and address"], "a": 0, "fb": "Free prize pop-ups are almost always tricks. Well done! 🎁"}, {"level": 2, "text": "A stranger sends you a link for free gems. What is the best move?", "options": ["Don't click, and tell a trusted adult", "Click to see what it is", "Send it to your friends"], "a": 0, "fb": "Never click links from people you don't know. 🔗"}, {"level": 2, "text": "Someone in a game asks where you live. What do you do?", "options": ["Say no, block them and tell a grown-up", "Tell them your street", "Tell them just your city"], "a": 0, "fb": "Shields up! Keep your location secret from online strangers. 🛡️"}, {"level": 2, "text": "What does the little padlock next to a website name tell you?", "options": ["Your connection to the site is private", "The site is just for kids", "The site is free"], "a": 0, "fb": "Look for the padlock. It shows your connection is protected. 🔒"}, {"level": 2, "text": "You want a new game. What is the safest way to get it?", "options": ["Ask a grown-up and use the official app store", "Click any download button you see", "Open a link from a message"], "a": 0, "fb": "Official stores check their apps. Always ask first! 📲"}, {"level": 3, "text": "Someone writes a mean comment on your drawing. What is a good move?", "options": ["Block them, tell a grown-up and keep creating", "Write something mean back", "Delete all your art"], "a": 0, "fb": "You keep shining! Mean comments are never your fault. 🎨"}, {"level": 3, "text": "A friend gets mean messages in a group chat. What can you do?", "options": ["Be kind to her and tell a trusted adult", "Laugh along", "Do nothing"], "a": 0, "fb": "You are a true friend and an upstander! 💜"}, {"level": 3, "text": "You have been on a screen for a long time and feel tired. What now?", "options": ["Take a break, drink water and play outside", "Keep going for one more hour", "Stay up all night"], "a": 0, "fb": "Breaks help your brain and body glow. 🌳"}, {"level": 3, "text": "Someone online says, \"Keep our chat a secret from your parents.\" What do you do?", "options": ["Tell a trusted adult right away", "Keep the secret", "Ask them to explain"], "a": 0, "fb": "Safe adults never ask kids to keep secrets like that. Telling is brave! 🦋"}, {"level": 3, "text": "A game has a Mute button. When is it great to use it?", "options": ["To quiet unkind players", "To be mean to someone", "To delete the game"], "a": 0, "fb": "Mute gives you peace and fun. 🔕"}, {"level": 4, "text": "A chat says \"Send this to 10 friends or something bad will happen!\" What do you do?", "options": ["Don't send it and ask a grown-up", "Send it to 10 friends", "Scare your friends"], "a": 0, "fb": "Chain messages are tricks. Stopping them is a hero move! 🦸"}, {"level": 4, "text": "Your friend wants to post a silly photo of you without asking. What do you say?", "options": ["\"Please ask me first!\"", "\"Sure, post anything\"", "Post one of her too"], "a": 0, "fb": "Everyone gets to decide about their own photos. 📸"}, {"level": 4, "text": "A video says a cat can talk like a person. How can you check it?", "options": ["Ask a grown-up and check a trusted website", "Share it right away", "Believe it because it's a video"], "a": 0, "fb": "Fact detectives always check first! 🔍"}, {"level": 4, "text": "You see something untrue online. What is a kind way to help?", "options": ["Tell a trusted adult or use the report button", "Shout at the person", "Copy it and share it"], "a": 0, "fb": "Kind and brave. Reporting helps everyone. 🌟"}, {"level": 4, "text": "What is a digital footprint?", "options": ["The trail of things you post and do online", "A footprint on your keyboard", "A level in a game"], "a": 0, "fb": "Like footprints in wet cement, it can stay a long time. Make yours great! 👣"}], "mid": [{"level": 1, "text": "Maya is creating a secret club account. Which password is safest?", "options": ["Maya2012", "P@ssw0rd123", "Purple-Galaxy-99#"], "a": 2, "fb": "Boom! Digital lock engaged! Random words + symbols create a fortress."}, {"level": 1, "text": "Why is it risky to use your pet's name and birth year as a password?", "options": ["Hackers can guess it from public social posts", "Computers will break down", "It uses too many numbers"], "a": 0, "fb": "Spot on! Keep personal clues out of your keys."}, {"level": 1, "text": "What is Two-Factor Authentication (2FA)?", "options": ["Having two accounts at once", "A second confirmation step like a text code or app prompt", "Sharing your password with two friends"], "a": 1, "fb": "Double lock security! Even if someone finds your password. They can't get in."}, {"level": 1, "text": "Your profile picture on a public gaming platform should ideally be:", "options": ["A clear selfie showing your face and school", "An avatar or cool graphic that doesn't reveal personal info", "A photo of your house exterior"], "a": 1, "fb": "Smart avatar choice! Keep your real-world landmarks private."}, {"level": 1, "text": "You are filling out a public game profile bio. Which detail is safe to share?", "options": ["Your home address and phone number", "Your favorite book genre and hobbies", "Your daily school schedule"], "a": 1, "fb": "Safe sharing! Hobbies are fun: private locations are locked down."}, {"level": 2, "text": "DM from 'Official_Admin' saying your account is banned. Action?", "options": ["Click link fast", "Reply asking for proof", "Ignore,block sender,check official settings"], "a": 2, "fb": "Smart thinking! Real security teams never send suspicious links DMs."}, {"level": 2, "text": "You see a pop-up saying: ''CONGRATS! You won a free tablet! Click here!''", "options": ["Click immediately to claim it", "Close the window safely", "Type your home address in the box"], "a": 1, "fb": "Bullet dodged! Free prize pop-ups are almost always traps."}, {"level": 2, "text": "What does HTTPS at the beginning of a website URL mean?", "options": ["The site is extra fun", "The connection is encrypted and secure", "The site is owned by your school"], "a": 1, "fb": "Secure connection verified! Always look for that 'S'."}, {"level": 2, "text": "A stranger adds you on a game and ask what city you live in. What do you do?", "options": ["Tell them your country only", "Answer honestly so you can play together", "Decline/block and do not share location"], "a": 2, "fb": "Shields up! Never give location hints to online strangers."}, {"level": 2, "text": "You want to download a new mod for a game, but it's on a sketchy,random website.", "options": ["Download it right away", "Ask a trusted adult or check official trusted stores first", "Turn off your antivirus"], "a": 1, "fb": "Wise choice! Sketchy download sites love hiding malware."}, {"level": 3, "text": "Someone leaves a mean comment on Maya's video project.", "options": ["Reply with a mean comment", "Delete comment, block user, keep posting", "Delete her entire account"], "a": 1, "fb": "Shields up! Block, report, and keep shining!"}, {"level": 3, "text": "A friend starts receiving hurtful messages in a group chat. What should Maya do?", "options": ["Laugh along so she doesn't get targeted", "Take screenshots as proof, support her friend, and report it", "Leave the app and ignore everything"], "a": 1, "fb": "True friend and ally! Document and report toxic behavior."}, {"level": 3, "text": "You notice you've been scrolling through social feeds for 3 straight hours feeling drained.", "options": ["Keep scrolling until midnight", "Take a mindful break, log off, and step outside", "Delete the phone entirely"], "a": 1, "fb": "Digital wellness win! Balance is everything."}, {"level": 3, "text": "Someone online is pressuring you to keep a \"secret\" chat from your parents", "options": ["Keep the secret to look mature", "Break the secret rule immediately and tell a trusted adult", "Tell your online friend you'll think about it"], "a": 1, "fb": "Zero tolerance for secrecy tricks! Adults who demand secrets from kids are unsafe."}, {"level": 3, "text": "How do you use the 'Mute' or 'Restrict' tool effectively?", "options": ["To secretly spy on people", "To quiet negative accounts without them knowing, protecting your peace", "To delete your own profile"], "a": 1, "fb": "Peace of mind activated! Curate your digital energy."}, {"level": 4, "text": "Shocking group chat alert asking to forward to 10 friends.", "options": ["Forward immediately", "Verify on trusted news sites", "Reply telling everyone to panic"], "a": 1, "fb": "Fact-checker activated! Verifying stops viral fake news in its tracks."}, {"level": 4, "text": "Friend wants to post an embarrassing photo without permission.", "options": ["Remind her content can be saved/screenshotted", "Tell her to delete after 1 hr", "Post without tagging name"], "a": 0, "fb": "Digital Leader move! Always respect privacy and ask before posting."}, {"level": 4, "text": "You see an incredible, unbelievable scientific discovery shared by a meme account", "options": ["Share it as absolute fact", "Check if reputable science news outlets confirm it", "Ignore science completely"], "a": 1, "fb": "Critical thinker! Memes are for laughs, not breaking news."}, {"level": 4, "text": "You want to stand up to misinformation online safely. What is a great approach?", "options": ["Start a massive argument in the comments", "Politely share a fact-checked link from a credible source or report the post", "Insult the person who posted it"], "a": 1, "fb": "Grace under fire! Lead with facts and kindness."}, {"level": 4, "text": "Why does your digital footprint matter for your future?", "options": ["It doesn't matter; things disappear instantly", "Colleges, future employers, and communities can view past posts", "It only affects your phone battery"], "a": 1, "fb": "Visionary mindset! Build a footprint you'll be proud of tomorrow"}], "t13": [{"level": 1, "text": "Your best friend asks for your password \"to prove we're close\". What is the best reply?", "options": ["Say no kindly. Real friends respect privacy", "Share it, she's your best friend", "Share it now and change it later"], "a": 0, "fb": "Friendships change, but a shared password gives access to your messages and photos. Keep it yours. 🔐"}, {"level": 1, "text": "What is the best way to set up account recovery?", "options": ["Add a recovery email and phone number only you control", "Use a friend's email so you won't forget", "Skip it, you'll remember"], "a": 0, "fb": "If you are ever locked out, only you should be able to get back in. 📧"}, {"level": 1, "text": "You are setting up a new social account. Which setting is the best start?", "options": ["A private account where you approve people you know", "A public account to get more followers", "Public, but with no photo"], "a": 0, "fb": "Start private and open up only if you choose to. 🔒"}, {"level": 1, "text": "A site wants your full name, birthday, school and phone number just to read an article. What do you do?", "options": ["Share only what is needed, or skip the site", "Fill in everything", "Use a friend's details"], "a": 0, "fb": "Only give what a site really needs. The rest stays yours. 🛡️"}, {"level": 1, "text": "Which username is safest for a public gaming profile?", "options": ["StarlightFox_77", "SaraAhmed_Grade8", "Sara_StMarys_2011"], "a": 0, "fb": "A made-up name hides your real name, school and birth year. 🎭"}, {"level": 2, "text": "A DM says you won a phone and only need to pay a small shipping fee. What do you do?", "options": ["Ignore it and report it, because real prizes don't ask for money", "Pay, it is only a small fee", "Share it so friends can enter"], "a": 0, "fb": "Prizes that ask you to pay first are scams. 🎁"}, {"level": 2, "text": "A poster has a QR code promising free data. What should you do first?", "options": ["Check the poster is official and where the link goes", "Scan it, QR codes are always safe", "Scan it and enter your number"], "a": 0, "fb": "QR codes can open fake sites, so check before you trust them. 📷"}, {"level": 2, "text": "A player in chat says, \"Download this file for free in-game currency.\" It ends in .exe. What is the risk?", "options": ["It could be malware that steals your accounts", "There is no risk, he's a gamer", "It will only slow your game"], "a": 0, "fb": "Files from strangers can hide malware. Never run them. 💾"}, {"level": 2, "text": "A flashlight app asks for your contacts, microphone and location. What do you do?", "options": ["Deny it and find a safer app", "Allow everything", "Allow only the microphone"], "a": 0, "fb": "Permissions should match the app's job. A flashlight needs none of those. 📱"}, {"level": 2, "text": "A pop-up says \"Your device has a virus! Call this number now!\" What does it want?", "options": ["To scare you into paying or giving access", "To help you fix your phone", "To update your system"], "a": 0, "fb": "Real warnings never ask you to call a number from a pop-up. ☎️"}, {"level": 3, "text": "A classmate makes a fake profile pretending to be you. What are the first steps?", "options": ["Screenshot it, report the profile and tell a trusted adult", "Make a fake profile of them", "Ignore it forever"], "a": 0, "fb": "Evidence plus reporting gets the profile removed. You are not alone. 🎭"}, {"level": 3, "text": "Your group chat jokes hurt one person and you feel uneasy. What can you do?", "options": ["Say it isn't okay and support her privately", "Join in to fit in", "Stay silent"], "a": 0, "fb": "Speaking up even once can change a whole chat. 👥"}, {"level": 3, "text": "Someone shares a private photo of your friend without her consent. What is right?", "options": ["Don't share it, report it and help her tell a trusted adult", "Show it to one friend", "Comment on it"], "a": 0, "fb": "Sharing private images hurts and can be against the law. Be the one who helps. 📵"}, {"level": 3, "text": "You compare your life to others online and feel left out. What helps?", "options": ["Remember posts are highlights, limit scrolling and talk to someone you trust", "Post more to look happier", "Unfollow all your friends"], "a": 0, "fb": "What you see online is the best moments, not the whole story. 🪞"}, {"level": 3, "text": "An online friend wants to move to a private app and asks you not to tell your parents. What do you do?", "options": ["Say no, stop chatting and tell a trusted adult", "Move, they seem nice", "Move but keep it secret"], "a": 0, "fb": "Safe friends never ask you to keep secrets from your family. 🚨"}, {"level": 4, "text": "A post says \"Doctors don't want you to know this trick!\" What is the red flag?", "options": ["Big secret claims with no sources", "It has pictures", "Lots of people liked it"], "a": 0, "fb": "Shocking claims without evidence are a warning sign. 🕵️"}, {"level": 4, "text": "Two websites give opposite facts. How do you decide?", "options": ["Check who runs each, their sources and other reliable outlets", "Pick the one with the nicer design", "Pick the one you agree with"], "a": 0, "fb": "Good thinkers check, not just choose. ⚖️"}, {"level": 4, "text": "An influencer promotes a product with #ad. What does that mean?", "options": ["They were paid or given something to promote it", "It is the best product", "The government approved it"], "a": 0, "fb": "Ads can be fine, but know when someone is paid. 💰"}, {"level": 4, "text": "Before posting a party photo of your friends, you should:", "options": ["Ask them if they are comfortable with it", "Post it, it is your photo", "Tag them first"], "a": 0, "fb": "Respecting consent is real leadership. 🤳"}, {"level": 4, "text": "How can you be a positive digital leader at school?", "options": ["Share kind posts, report harm and help classmates stay safe", "Ignore online problems", "Call people out in public"], "a": 0, "fb": "Leaders lift others up. 🌟"}], "teen": [{"level": 1, "text": "Which approach protects your accounts best?", "options": ["A unique passphrase for each account, kept in a password manager", "One strong password used everywhere", "Your usual password with one letter changed"], "a": 0, "fb": "A leak on one site can't unlock the others when every password is unique. 🔑"}, {"level": 1, "text": "For two-factor login, which is generally stronger?", "options": ["An authenticator app", "A code sent by SMS", "Having no second step"], "a": 0, "fb": "Text messages can be intercepted, for example by SIM-swapping. An app is harder to steal. 🔢"}, {"level": 1, "text": "You get a login alert from a country you've never visited. First step?", "options": ["Change your password, log out other devices and check 2FA", "Ignore it", "Reply to the alert with your password"], "a": 0, "fb": "Quick action shuts the door before anything is lost. 🚨"}, {"level": 1, "text": "A hacked friend's account sends you \"Is this you in this video?\" with a link. What do you do?", "options": ["Don't click, and warn them another way", "Click to see", "Forward it to others"], "a": 0, "fb": "Hacked accounts spread links to hack more accounts. Warning them helps everyone. 🧑‍💻"}, {"level": 1, "text": "Why be careful about logging in on public Wi-Fi?", "options": ["Others on the network may spy on unprotected traffic", "It makes your phone slower", "It deletes your saved logins"], "a": 0, "fb": "Use a trusted network or save sensitive logins for later. 📶"}, {"level": 2, "text": "An email says your streaming account closes in 24 hours unless you \"verify\". What are the red flags?", "options": ["Urgency, a link and a vague greeting", "It has a company logo", "It is sent during the day"], "a": 0, "fb": "Pressure plus a link is the classic phishing recipe. 🎣"}, {"level": 2, "text": "What is the safest way to check if a message from your bank or platform is real?", "options": ["Open the official app or type the website yourself", "Call the number in the message", "Reply and ask if it is real"], "a": 0, "fb": "Never trust contact details that came in the message itself. 📲"}, {"level": 2, "text": "A link shows \"paypa1-support.com\". What's wrong?", "options": ["It's a lookalike address using a 1 instead of an l", "Nothing, it looks fine", "It is too short"], "a": 0, "fb": "Scammers swap characters to fool fast readers. Slow down and zoom in. 🌐"}, {"level": 2, "text": "A \"free skins generator\" asks you to log in with your game account. What can happen?", "options": ["Scammers take over your account", "You get free skins", "Your level goes up"], "a": 0, "fb": "No real generator exists. They only want your login. 🎮"}, {"level": 2, "text": "Your browser warns that a site's certificate is invalid before you enter card details. What do you do?", "options": ["Leave the site without entering anything", "Click through anyway", "Refresh until the warning goes away"], "a": 0, "fb": "That warning means the connection may not be safe. Trust it. ⚠️"}, {"level": 3, "text": "You are being targeted by repeated harassing comments. What is the best approach?", "options": ["Screenshot the evidence, block and report, and tell someone you trust", "Reply to defend yourself", "Delete everything and quit the app"], "a": 0, "fb": "Evidence plus reporting protects you, and you don't carry it alone. 📸"}, {"level": 3, "text": "Someone you only know online keeps asking for private photos and says to keep it secret. What now?", "options": ["Stop replying, save the evidence, block, report and tell a trusted adult", "Send one to calm them down", "Negotiate with them"], "a": 0, "fb": "Pressure for pictures or secrecy is a serious warning sign. It is never your fault, and telling someone is the strong move. 💜"}, {"level": 3, "text": "Scrolling leaves you anxious and comparing yourself to edited photos. A healthy step is:", "options": ["Curate your feed, set time limits and remember posts are filtered", "Follow more influencers", "Scroll faster to finish"], "a": 0, "fb": "Your feed should lift you up. You get to shape it. 🪞"}, {"level": 3, "text": "A group chat is spreading a humiliating screenshot of a classmate. As a bystander, the strongest move is:", "options": ["Don't share it, support them and report it", "Forward it to a few friends", "Say nothing"], "a": 0, "fb": "Bystanders can stop the spread. Kindness takes courage. 🛡️"}, {"level": 3, "text": "A friend says they feel hopeless after online bullying. What is a good response?", "options": ["Listen, take it seriously and encourage them to talk to a trusted adult or counsellor", "Tell them to toughen up", "Post about it online"], "a": 0, "fb": "You don't have to fix everything. Being there and pointing to help matters. 🤝"}, {"level": 4, "text": "What is the best check for a shocking viral claim?", "options": ["Check who published it, find the story on reputable sources and reverse-image search", "Count the likes", "See if it matches your opinion"], "a": 0, "fb": "Good checking beats fast sharing every time. 🔎"}, {"level": 4, "text": "You see a video of a famous person saying something outrageous. It could be a deepfake. What do you do?", "options": ["Look for the original source before believing or sharing", "Share it quickly", "Trust it, since video can't lie"], "a": 0, "fb": "Video can be faked now. Trace it back first. 🎭"}, {"level": 4, "text": "What is confirmation bias?", "options": ["Believing things that match what you already think without checking", "Checking many different sources", "Only reading headlines"], "a": 0, "fb": "Knowing your own bias makes you a sharper thinker. 🧠"}, {"level": 4, "text": "Before posting a group photo, the leadership move is to:", "options": ["Ask everyone in it for permission", "Post it and tag everyone", "Post it and delete later if someone complains"], "a": 0, "fb": "Consent first. That's real leadership. 🤳"}, {"level": 4, "text": "Why does your digital footprint matter for your future?", "options": ["Schools and employers can see it, and deleted posts can still be copied", "It only affects phone storage", "Everything disappears after a week"], "a": 0, "fb": "Build a footprint you will be proud to show. 👣"}], "t17": [{"level": 1, "text": "A site you use announces a data breach. What do you do first?", "options": ["Change that password and any place you reused it, and turn on 2FA", "Wait and see if anything happens", "Delete the app only"], "a": 0, "fb": "Fast action closes the door before criminals use your details. 🚨"}, {"level": 1, "text": "How can you check if your email was in a known data breach?", "options": ["Use a reputable breach-checking service", "Reply to an email asking for your password", "Run a social media poll"], "a": 0, "fb": "Stick to well-known services, and never type your password into one. 🔎"}, {"level": 1, "text": "Which details should you keep off public profiles and CVs?", "options": ["Home address, ID numbers and date of birth", "Your skills", "Your favourite subjects"], "a": 0, "fb": "Those details help criminals steal identities. 🪪"}, {"level": 1, "text": "Your phone is stolen. What is the most important first step?", "options": ["Lock or remotely wipe it and change key passwords", "Wait for the thief to call", "Post about it on social media"], "a": 0, "fb": "Act quickly so no one can get into your accounts. 📱"}, {"level": 1, "text": "What is the best habit on a shared computer?", "options": ["Log out, don't save passwords and use private browsing", "Stay logged in", "Save passwords for next time"], "a": 0, "fb": "Leave no keys behind. 💻"}, {"level": 2, "text": "A job ad offers big daily pay to receive money and forward it. What is it likely to be?", "options": ["A money mule scam that can get you in legal trouble", "A normal job", "A bank promotion"], "a": 0, "fb": "Moving money for strangers can make you part of a crime. 💼"}, {"level": 2, "text": "An online \"coach\" guarantees fast crypto profits if you send money first. What do you do?", "options": ["Walk away, guaranteed returns are a scam sign", "Send a small test amount", "Invite your friends"], "a": 0, "fb": "No honest investment can promise profits. 📈"}, {"level": 2, "text": "You get a text that a parcel is held and you must pay a fee via a link. You aren't expecting a parcel. Best move?", "options": ["Don't click, check the courier's official app or site", "Pay quickly", "Reply with your card details"], "a": 0, "fb": "Go to the real source yourself. 📦"}, {"level": 2, "text": "What does end-to-end encryption in a messaging app mean?", "options": ["Only you and the person you message can read the content", "The company reads everything", "Messages can never be deleted"], "a": 0, "fb": "It protects your chats from outsiders and even the service itself. 🔐"}, {"level": 2, "text": "An app is free but asks for broad permissions and ads follow you around. What is likely happening?", "options": ["Your data is the product, and it is collected and sold", "Nothing at all", "The app is paying you"], "a": 0, "fb": "If you don't pay for it, check what it takes from you. 🧾"}, {"level": 3, "text": "Someone threatens to share a private picture of you unless you pay or send more. What do you do?", "options": ["Don't pay or send anything, keep evidence, block, report and tell a trusted adult or authority", "Pay to make it stop", "Send more to calm them down"], "a": 0, "fb": "This is blackmail and it is never your fault. Reporting is the strong move, and help is available. 💜"}, {"level": 3, "text": "A partner wants constant location sharing and your passwords \"to prove trust\". This is:", "options": ["Controlling behavior, since trust doesn't need surveillance", "Normal in relationships", "A sign of love"], "a": 0, "fb": "Healthy relationships respect privacy and choice. 💞"}, {"level": 3, "text": "A friend's intimate image is going around a group chat. What is right?", "options": ["Don't open or forward it, report it and support your friend", "Forward it as a joke", "Save a copy"], "a": 0, "fb": "Spreading it adds harm and may be illegal. Standing up protects her. 🚫"}, {"level": 3, "text": "Late-night doomscrolling leaves you anxious and tired. What is a lasting fix?", "options": ["Set app limits, keep your phone out of the bedroom and wind down offline", "Scroll until you fall asleep", "Delete everything with no plan"], "a": 0, "fb": "Small habits give your mind room to rest. 🌙"}, {"level": 3, "text": "A friend posts that they feel hopeless and don't want to be here. What is the best response?", "options": ["Take it seriously, reach out and help them contact a trusted adult or crisis line", "Assume they are joking", "Reply publicly in the comments"], "a": 0, "fb": "Reaching out can make a huge difference. You don't have to handle it alone. 🤝"}, {"level": 4, "text": "You see a very real-looking AI image of a news event. What is smart?", "options": ["Check reliable news and the original source first", "Share it, images don't lie", "Assume all AI content is fake and all else is real"], "a": 0, "fb": "Today a picture is not proof. Check before you share. 🖼️"}, {"level": 4, "text": "Before applying for jobs or university, what is a smart footprint step?", "options": ["Search your own name, tidy public posts and tighten privacy settings", "Hope no one looks", "Delete your email"], "a": 0, "fb": "Be the first to see what others will see. 🎓"}, {"level": 4, "text": "What is a filter bubble?", "options": ["Feeds that mostly show what you already like, narrowing your view", "A kind of computer virus", "A privacy setting"], "a": 0, "fb": "Seek out different, reliable sources to see the whole picture. 🫧"}, {"level": 4, "text": "What should you avoid typing into an AI chatbot?", "options": ["Personal details like your full name, address, passwords or private photos", "Maths questions", "Essay topics"], "a": 0, "fb": "Treat chatbots like a public place for private information. 🤖"}, {"level": 4, "text": "How should you handle a public disagreement online?", "options": ["Stay respectful, stick to facts and step away if it turns abusive", "Post angry replies", "Screenshot to shame them"], "a": 0, "fb": "Calm and factual wins, and leaving is allowed. 🗣️"}]}, LESSONS={"young": [{"title": "Lock Your Digital Door", "points": [["🔑", "Think about what a key is for. Who should have a copy of yours?"], ["🦄", "Strong things are hard to guess. Could a friend guess yours in one try?"], ["🎭", "Before you share something online, ask: could a stranger find me with this?"]], "remember": "Think like a secret keeper! 🤫"}, {"title": "Think Before You Click", "points": [["🎁", "If something sounds too good to be true, pause and ask why."], ["🧑‍🏫", "When you are not sure, who is the best person to ask?"], ["🔗", "Look carefully at where a link or a download comes from."]], "remember": "Stop, think, then choose! 🚦"}, {"title": "Be Kind, Be Brave", "points": [["💜", "How would you like a friend to treat you if this happened to you?"], ["🧰", "Apps have tools to help you feel safe. Do you know where they are?"], ["🌈", "If something online makes you feel uncomfortable, who could you talk to?"]], "remember": "Kind and brave, that's me! 🦋"}, {"title": "Be a Fact Detective", "points": [["🔍", "Detectives look for clues before they decide. What clues can you check?"], ["📢", "Lots of people sharing something does not make it true."], ["👣", "Everything you post leaves a trail. Would you be happy for it to stay?"]], "remember": "I check first, then I share! 🌟"}], "mid": [{"title": "Lock Your Digital Front Door", "points": [["🔑", "Think about what a hacker could guess or find from your public posts."], ["📱", "Extra checks add safety. How could an app make sure it is really you?"], ["🎭", "Ask yourself: would this detail help a stranger find me in real life?"]], "remember": "Think smart, share smart! 💪"}, {"title": "Spot the Tricks", "points": [["🎣", "Tricksters use pressure and excitement. Slow down and look for clues."], ["🔒", "Check the address and the small signs in the browser bar."], ["🧑‍🤝‍🧑", "Would you tell a stranger in real life? Online is no different."]], "remember": "Slow down and check! 🔍"}, {"title": "Own Your Space", "points": [["🛠️", "Think about how to protect yourself and help others without making things worse."], ["📸", "Proof and trusted people are your best allies."], ["🚨", "If something feels wrong or secret, who could you talk to?"]], "remember": "I'm in charge of my space. 🦋"}, {"title": "Lead the Way", "points": [["🔎", "Before you share, ask: who says so, and can I find it somewhere else?"], ["💬", "Facts and kindness work better than insults. Why?"], ["👣", "Think about who might see your posts years from now."]], "remember": "Leaders think before they post. 🚀"}], "t13": [{"title": "Guard Your Accounts", "points": [["🤝", "Privacy and friendship can go together. What does each of your accounts give access to?"], ["📧", "Plan ahead for the day you get locked out."], ["🎭", "What could someone work out about you from a username or profile?"]], "remember": "Private by default, glowing by choice. 💪"}, {"title": "Spot the Scam", "points": [["🎁", "Ask who gains if you click, pay, download or allow."], ["📱", "Does the request match what the app or site really needs?"], ["⏸️", "Scammers want you to rush. What clues tell you to slow down?"]], "remember": "If it feels pushy, I pause. ⏸️"}, {"title": "Stand Up and Stay Strong", "points": [["🧰", "Think: evidence, reporting and trusted people."], ["🪞", "Remember what posts show and what they leave out."], ["🚩", "Notice when someone asks for secrecy or private contact. How does that feel?"]], "remember": "Speaking up is strength. 🦋"}, {"title": "Be a Smart Digital Leader", "points": [["🕵️", "Good claims come with sources. Where are they?"], ["⚖️", "Who runs the site, and what do they gain?"], ["🌟", "What would a kind leader do before posting about others?"]], "remember": "Smart, kind and fearless online. 🚀"}], "teen": [{"title": "Lock Down Your Accounts", "points": [["🔑", "Think about what happens to your other accounts if one password leaks."], ["🔢", "Not all second checks are equally hard to steal."], ["🚨", "Unusual activity needs fast action. What would you do first?"]], "remember": "Strong habits now protect me for years. 💪"}, {"title": "Outsmart the Scammers", "points": [["⏰", "Look for pressure, odd addresses and where a link really goes."], ["📲", "How could you check a message without using anything inside it?"], ["⚠️", "Browser warnings exist for a reason."]], "remember": "Verify first. Scammers hate that. 🔍"}, {"title": "Protect Your Peace", "points": [["📸", "Think evidence, blocking, reporting and trusted people."], ["🪞", "Remember that feeds are edited."], ["🛡️", "Bystanders have power. What choices do you have?"]], "remember": "Looking after myself and others is strength. 🦋"}, {"title": "Think Like a Leader", "points": [["🔎", "Who published it, who else reports it, and what does the original show?"], ["🧠", "We tend to believe what we already think. How can you test that?"], ["👣", "Think about what stays online after you delete."]], "remember": "Leadership is asking better questions. 🚀"}], "t17": [{"title": "Protect What's Yours", "points": [["🚨", "After a leak, think about every place the same password lives."], ["🪪", "Which details would a criminal need to pretend to be you?"], ["💻", "Think about what you leave behind on devices you don't own."]], "remember": "Adult habits start now. 💪"}, {"title": "Scam-Proof Your Life", "points": [["💼", "If it promises easy money or guaranteed profit, ask who really gains."], ["📦", "Go to official sources yourself, not through messages."], ["🧾", "If a service is free, how might it earn money?"]], "remember": "If it sounds too good to be true, I check. 🔍"}, {"title": "Healthy Relationships and Mind", "points": [["💜", "Think about consent, control and who can help."], ["🌙", "Habits shape mood. What small change could help?"], ["🤝", "When someone is struggling, who could you connect them with?"]], "remember": "Respect, consent and care, for me and for others. 💜"}, {"title": "Lead with Your Digital Footprint", "points": [["🖼️", "Convincing does not mean true. What would prove it?"], ["🎓", "Search yourself the way others would."], ["🗣️", "Disagreement is fine. How do you stay in control of your tone?"]], "remember": "My footprint is my future. Let it shine. 🌟"}]};
